# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file.

# Postgres connection string. Use the docker-compose service, or your own local Postgres.
DATABASE_URL="postgresql://txnsim:txnsim_dev_password@localhost:5432/txnsim?schema=public"

# Secret used to sign JWTs. Generate your own random 32+ byte value for anything beyond a local demo.
JWT_SECRET="replace-this-with-a-long-random-development-only-secret"
JWT_EXPIRES_IN="8h"

PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# This application NEVER connects to real Visa, Mastercard, or banking endpoints.
# This flag exists only so the codebase has a single, explicit place documenting that fact.
SIMULATION_MODE_ONLY=true
