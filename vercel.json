{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build && mkdir -p dist/jvf-transaction-log && cp jvf-transaction-log/*.html dist/jvf-transaction-log/",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/logs",
      "destination": "/jvf-transaction-log/jvf-log.html"
    },
    {
      "source": "/input",
      "destination": "/jvf-transaction-log/jvf-input.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
